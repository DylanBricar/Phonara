{
  "name": "phonara-app",
  "private": true,
  "version": "0.9.1",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:phonaradev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build:phonaradev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test": "bun run test:unit && bun run test:playwright",
    "test:unit": "bun test tests/unit --coverage --coverage-reporter=text",
    "test:packaging": "bun test tests/unit/packagingScripts.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "quality:check": "bun run check:translations && bun run check:secrets && bun run check:model-languages && bun run lint && bunx tsc --noEmit --project tsconfig.json && bun run test:unit && bun run build && bun run test:playwright && bun audit && bun run format:check",
    "quality:rust": "cd src-tauri && cargo fmt -- --check && cargo clippy --locked --all-targets --all-features -- -D warnings && cargo test --locked --all-targets --all-features",
    "audit:rust": "cargo audit --deny warnings --file src-tauri/Cargo.lock",
    "check:secrets": "bun scripts/check-secrets.ts",
    "precommit": "bun scripts/pre-commit-check.ts",
    "prepare": "bun scripts/install-git-hooks.ts",
    "check:translations": "bun scripts/check-translations.ts",
    "storybook": "bunx --bun ladle serve --port 1422",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "postinstall": "bun scripts/check-nix-deps.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.3",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.4",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "i18next": "^26.4.1",
    "immer": "^11.1.18",
    "lucide-react": "^0.542.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.6",
    "typescript": "~5.6.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "browserslist": "4.28.8",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
